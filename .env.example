# Daily Stack Lab — Environment Variables
# Copy this file to ".env" for local use (note: this app does NOT load .env automatically;
# pass them inline when running node, or set them in your host's dashboard).

# Server port (default 5177)
PORT=5177

# Required before going live: protects the admin dashboard and CSV export.
# Pick a strong random string. Example: openssl rand -hex 24
ADMIN_TOKEN=

# Lead webhook destination. Set this to the Google Sheets Apps Script URL
# (see GOOGLE_SHEETS_SETUP.md) or swap for an Airtable/HubSpot/Klaviyo webhook.
CRM_WEBHOOK_URL=

# Optional analytics IDs. The current index.html has commented-out script
# blocks for each — uncomment and paste your IDs there when ready.
# GA4_MEASUREMENT_ID=G-XXXXXXXX
# META_PIXEL_ID=000000000000
# TIKTOK_PIXEL_ID=XXXXXXXXXX
